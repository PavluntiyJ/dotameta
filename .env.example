# Copy this template to an ignored .env. Never put live credentials in this
# tracked example, CLI commands, issues, or chat.

# Optional; ordinary OpenDota use needs no key. Keys can provide higher limits.
# Official key page and current terms: https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# Optional. Sign in with Steam at https://stratz.com/api, then use the default
# token shown under My Tokens. The page shows current quotas and token options.
STRATZ_API_TOKEN=

# Optional convenience default for --account-id; this is not a credential.
DOTAMETA_ACCOUNT_ID=
