# Optional. Without a key OpenDota allows ~60 req/min and 2000 calls/day.
# Get one at https://www.opendota.com/api-keys (requires a payment method).
OPENDOTA_API_KEY=

# Optional, and free: sign in with Steam at https://stratz.com/api - no card.
# When set, dotameta can use Stratz for Immortal meta, real positions 1-5,
# and ranked-All-Pick personal aggregates when OpenDota hero data is unavailable.
# Stratz aggregates have no rank, recency, lanes, or pace.
# 2000 requests/hour on a default token, 4000/hour with a personal one.
STRATZ_API_TOKEN=

# Default player to analyse so you can omit --account-id
DOTAMETA_ACCOUNT_ID=
